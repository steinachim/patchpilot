    <string name="settings_theme_default">System Default</string>
    <string name="settings_theme_default_description">Follows your device\'s light/dark setting and wallpaper colours.</string>
    <string name="settings_theme_steampunk">Steampunk</string>
    <string name="settings_theme_steampunk_description">Brass, copper and mechanical dials — a fixed dark look.</string>
    <string name="settings_legal_heading">Legal</string>
    <string name="settings_open_source_licenses">Open Source Licenses</string>
    <string name="licenses_title">Open Source Licenses</string>
    <string name="licenses_patchpilot_license">GNU General Public License v3.0</string>
    <string name="licenses_apache_license">Apache License, Version 2.0</string>
