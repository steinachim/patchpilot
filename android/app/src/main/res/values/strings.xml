    <!-- Presets screen. -->
    <string name="programs_filter_hint">Filter by name</string>
    <string name="programs_show_empty">Show empty slots</string>
    <string name="programs_bank_header">Bank %1$s</string>
    <string name="programs_slot_empty">Empty</string>
    <string name="programs_no_category">No category</string>
    <string name="programs_no_presets">This instrument reports no presets.</string>
    <string name="programs_no_matches">No presets match \"%1$s\".</string>
    <!-- Which of an instrument's listings is shown. Only instruments offering more than one
         show these at all. -->
    <string name="programs_scope_user">User</string>
    <string name="programs_scope_factory">Factory</string>
    <string name="programs_scope_favorites">Favorites</string>
    <string name="programs_scope_note_factory">Names come from the manufacturer\'s data list, not read from this instrument.</string>
    <string name="programs_scope_note_favorites">Marked on the instrument. Use Set favorite in a row menu to change one.</string>
    <string name="programs_no_favorites">Nothing is marked as a favorite on this instrument.</string>
    <string name="programs_no_favorites_hint">Mark one with Set favorite in a row menu, or on the instrument itself — on a Motif XS, hold [CATEGORY SEARCH] and use the [FAVORITE] bank. Pull down to re-read them.</string>
    <string name="programs_share_report">Share device details</string>
    <string name="share_reading_device">Reading device\u2026</string>
    <string name="programs_shared_as">Shared as %1$s.</string>
    <string name="programs_file_name">File name</string>
    <string name="programs_json_suffix">.json</string>
    <string name="programs_txt_suffix">.txt</string>
    <string name="programs_new_name">New name</string>
    <string name="programs_name_counter">%1$d / %2$d</string>
    <string name="programs_rename_title">Rename %1$s</string>

    <!--
      The two tag dialogs. A Motif XS voice carries two category assignments, and its favorite
      flag names which of those the instrument's own browser files it under - so the favorite
      dialog offers the voice's own categories and nothing else, and has something to say when
      there are none to offer.
    -->
    <string name="programs_favorite_title">Set favorite — %1$s</string>
    <string name="programs_favorite_body">Show this preset under:</string>
    <string name="programs_favorite_slot">Category %1$d</string>
    <string name="programs_favorite_clear_hint">Clearing every box removes the favorite.</string>
    <string name="programs_categories_sub">Sub-category</string>
    <string name="programs_categories_none">None</string>
    <string name="programs_categories_no_sub">—</string>
    <string name="programs_delete_title">Delete %1$s?</string>
    <!--
      Two forms because a named preset and an empty slot warrant different
      sentences, and "erases  on the instrument" is what one string with an
      optional name produces when the name is absent.
    -->
    <string name="programs_delete_body">This erases %1$s on the instrument.</string>
    <string name="programs_delete_body_named">This erases %1$s (\"%2$s\") on the instrument.</string>
    <string name="programs_copy_title">Copy %1$s to…</string>
    <string name="programs_move_title">Move %1$s to…</string>
    <string name="programs_error">Error: %1$s</string>

    <!--
      What the progress line says while an operation runs. Each is also the phrase the failure
      message and the log line are built from, with the ellipsis trimmed - so "Selecting A:1:1\u2026"
      becomes "Selecting A:1:1 failed." with no second copy of the wording to keep in step.
    -->
    <string name="programs_busy_selecting">Selecting %1$s\u2026</string>
    <string name="programs_busy_deleting">Deleting %1$s\u2026</string>
    <string name="programs_busy_renaming">Renaming %1$s\u2026</string>
    <string name="programs_busy_favoriting">Setting the favorite for %1$s\u2026</string>
    <string name="programs_busy_categorising">Setting the categories of %1$s\u2026</string>
    <string name="programs_busy_reading_tags">Reading %1$s\u2026</string>
    <string name="programs_busy_copying">Copying %1$s to %2$s\u2026</string>
    <string name="programs_busy_moving">Moving %1$s to %2$s\u2026</string>
    <string name="programs_busy_swapping">Swapping %1$s and %2$s\u2026</string>
    <string name="programs_busy_applying_fix">Changing the instrument\'s state\u2026</string>
    <string name="programs_operation_failed">%1$s failed.</string>

    <!--
      What an operation reports back once it has succeeded. These sit here rather than beside the
      operation because they are the app's own words about what it did, not an instrument's
      description of a protocol condition - which is the line the header above draws.
    -->
    <string name="result_moved">Moved %1$s to %2$s.</string>
    <string name="result_swapped">Swapped %1$s and %2$s.</string>
    <string name="result_renamed">Preset %1$s has been renamed to %2$s.</string>
    <string name="result_favorite_set">%1$s is now a favorite.</string>
    <string name="result_favorite_cleared">%1$s is no longer a favorite.</string>
    <string name="result_categories_set">%1$s is now filed under %2$s.</string>
    <string name="result_categories_cleared">%1$s no longer has a category.</string>
    <string name="result_copied">Copied %1$s to %2$s as \"%3$s\".</string>
    <string name="result_deleted">Preset %1$s has been deleted.</string>

    <!-- Connection failures the app itself raises, as opposed to ones an instrument reports. -->
    <string name="connect_failed">Failed to connect</string>
    <string name="connect_failed_demo">Failed to start demo mode</string>
    <string name="connect_permission_denied">Permission was denied for %1$s.</string>
    <string name="connect_usb_permission_denied">USB permission was denied for %1$s.</string>
    <string name="connect_opening_device_unplugged">%1$s was unplugged before the connection finished.</string>
    <string name="listing_unknown_error">Unknown error</string>
    <string name="listing_reading_presets">Reading the preset list\u2026</string>
    <string name="debug_regression_starting">Starting\u2026</string>

    <!-- Fallback label for a remedy the family offered without naming its button. -->
    <string name="programs_blocked_action_default">Fix it</string>

    <!-- Shown while nothing is connected - briefly, mid-reconnect, and never for long: a
         ProgramsScreen that lands on a settled failure/choice state hands off to ConnectScreen
         instead of sitting here (see ProgramsScreen's session-lost effect). Says so rather than
         naming a screen, since a bug that manages to strand this title here should not also
         read as an unrelated screen name. -->
    <string name="programs_title_fallback">Not Connected</string>
    <!-- Shown in place of the list while the first read runs and while a resume rebuilds the USB session. -->
    <string name="programs_reconnecting">Connecting…</string>

    <!--
      What a delete actually does, which differs by family: a Nord empties the slot with one
      command, while a Pro-800 and a Motif XS overwrite it with an initialised preset.
    -->
    <string name="programs_delete_effect_emulated">The preset is overwritten with an empty one. This app cannot undo it.</string>
    <string name="programs_delete_effect_native">The instrument empties the slot. This app cannot undo it.</string>

    <!--
      Debug menu: hidden behind five taps on the instrument name, so nothing here
      is ever read by somebody who has not gone looking for it.
    -->
    <string name="debug_title">Debug</string>
    <string name="debug_report_body">Reads every configuration detail off the instrument into a JSON report, which can then be shared or saved to this device. Nothing is written to the instrument.</string>
    <string name="debug_report_action">Generate device report</string>
    <string name="debug_report_running">Generating the device report\u2026</string>
    <string name="debug_report_ready">Device report ready</string>
    <string name="debug_report_ready_body">Read from the instrument: %1$d KB of JSON. Share it, or save it to this device. Going back discards it.</string>
    <string name="debug_regression_body">Runs every operation this instrument supports and reports what worked. Edits are made against a copy the test creates and deletes again; where no free slot exists, it asks first.</string>
    <string name="debug_regression_action">Run regression test</string>
    <!-- Checking the shipped factory voice names against the instrument itself. Read-only. -->
    <string name="debug_verify_body">The factory voice names shown in the browser are transcribed from the manufacturer\'s data list, not read from this instrument. This reads one factory bank and reports any name that disagrees. It writes nothing, and takes a couple of minutes per bank.</string>
    <string name="debug_verify_action">Check %1$s against the instrument</string>
    <string name="debug_verify_starting">Reading the bank…</string>
    <string name="debug_verify_ok">%1$s: every name matches what the app ships.</string>
    <string name="debug_verify_mismatches">%1$s: %2$d name(s) disagree with what the app ships:</string>
    <string name="debug_regression_running">Running the regression test…</string>
    <string name="debug_regression_share">Share regression report</string>
    <string name="debug_regression_back">Back to the debug menu</string>
    <string name="debug_confirm_select_title">Check the instrument</string>
    <string name="debug_confirm_select_body">The instrument was told to load %1$s. Is that what it is showing now?</string>
    <string name="debug_confirm_select_yes">Yes, it is showing that</string>
    <string name="debug_confirm_select_no">No, it is not</string>
    <string name="debug_confirm_occupied_title">Test against a stored preset?</string>
    <string name="debug_confirm_occupied_body">%1$s, so rename, move and swap can only be tested on a preset you actually have. Each one is undone immediately afterwards and checked, but if the instrument fails halfway a preset may be left renamed or in the wrong slot. Nothing will be deleted either way.\n\nDecline to skip these three tests.</string>
    <string name="debug_confirm_occupied_reason_no_slot">There is no free slot to make a scratch copy in</string>
    <string name="debug_confirm_occupied_reason_no_copy">This instrument has no way to copy a preset</string>
    <string name="debug_confirm_occupied_yes">Test on a stored preset</string>

    <!--
      One slot failing is not the same as the scan failing, which is why this is
      a count rather than an error: the other 415 are still worth showing.
    -->
    <plurals name="programs_unreadable_slots">
        <item quantity="one">%1$d slot could not be read.</item>
        <item quantity="other">%1$d slots could not be read.</item>
    </plurals>

    <!--
      How many categories a preset holds is a per-family fact, so the three places that name
      them are plurals rather than fixed text. A Nord program has one, a Motif XS voice two,
      and "Set categories" on an instrument with a single one reads like a mistake.

      The quantity is the *number of assignments the instrument has*, not an index - which is
      why programs_categories_main can drop the number entirely in the singular case: with one
      category there is nothing for "Category 1" to distinguish it from.
    -->
    <plurals name="action_set_categories">
        <item quantity="one">Set category</item>
        <item quantity="other">Set categories</item>
    </plurals>
    <plurals name="programs_categories_title">
        <item quantity="one">Set category — %1$s</item>
        <item quantity="other">Set categories — %1$s</item>
    </plurals>
    <plurals name="programs_categories_main">
        <item quantity="one">Category</item>
        <item quantity="other">Category %1$d</item>
    </plurals>
</resources>
