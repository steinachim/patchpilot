<?xml version="1.0" encoding="utf-8"?>
<!--
  Every string the user can read.

  Resources rather than inline literals, not for localization - this is a
  single-purpose tool with one language - but because a string in a resource is
  one somebody can find, review and change without reading Compose, and because
  a wording change stops being a code change.

  What is deliberately NOT here: the messages the instrument layer raises
  (`devices/*`), which explain a protocol condition and are written to be read by
  whoever is holding the phone. Those stay next to the condition that produces
  them - moving them here would put the wording two files away from the code that
  decides when it applies, and they are the one kind of message where that
  distance costs something.

  Naming: `action_*` for buttons, `<screen>_*` for text belonging to one screen,
  `cd_*` for content descriptions, which are read aloud rather than displayed.
-->
<resources>
    <string name="app_name">Patch Pilot</string>

    <!-- Buttons and menu items, shared across screens. -->
    <string name="action_cancel">Cancel</string>
    <!-- Shown when the instrument's own state stops an operation the app can offer to fix,
         e.g. a Motif XS in Performance mode ignoring a voice selection. -->
