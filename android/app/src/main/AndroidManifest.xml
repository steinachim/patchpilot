<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- required="false" deliberately: a phone without MIDI support must still be able to install
         this and use the working USB half of it, rather than being filtered out of the store
         entirely. MidiDiscovery returns nothing where the service is absent. -->
    <uses-feature
        android:name="android.hardware.midi"
        android:required="false" />

    <!-- Held by this app alone (protectionLevel="signature" grants it only to apps signed with
         the same key), and required of whatever sends UsbConnectionManager's USB_PERMISSION
         broadcast - see the receiver's own comment in UsbConnectionManager.kt for why. -->
    <permission
        android:name="de.thewolfwalkexperience.software.patchpilot.permission.USB_PERMISSION_CALLBACK"
        android:protectionLevel="signature" />

    <!-- allowBackup is off deliberately. Nothing here is worth restoring onto another phone, and
         some of it is worth not copying off this one: the app stores no credentials and
         PresetIndexCache is deliberately in-memory (see its own note on why persistence was
         declined), so a backup would carry little more than the cache directory - which is where
         shared device reports, containing the user's preset names, are staged. Turned off now
         rather than when that changes: the cache's documentation already contemplates a
         disk-backed variant, and that is exactly the change that would make an inherited default
         matter. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.PatchPilot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Shares the JSON built by InstrumentViewModel.buildDeviceReport() (see
             ProgramsScreen's "Share device info" button) as a content:// file, since
             ACTION_SEND with EXTRA_STREAM needs a content Uri, not a raw file:// path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
